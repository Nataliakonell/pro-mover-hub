# Configurações do Servidor Local Frontend
PORT=8080
VITE_PORT=8080

# Configurações da Aplicação
VITE_APP_TITLE=PRO-MOVER Hub
VITE_APP_ENV=development

# URL Base da API do Backend (Node.js/Express na porta 5000)
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api

# Habilitar ferramentas de depuração (true/false)
VITE_ENABLE_DEVTOOLS=true

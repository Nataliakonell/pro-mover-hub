# Configurações do Servidor Local
PORT=8080
VITE_PORT=8080

# Configurações da Aplicação
VITE_APP_TITLE=PRO-MOVER Hub
VITE_APP_ENV=development

# URL Base da API (quando integrado com backend / serviços de nuvem)
VITE_API_BASE_URL=http://localhost:8080/api

# Habilitar ferramentas de depuração (true/false)
VITE_ENABLE_DEVTOOLS=true

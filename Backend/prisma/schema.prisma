// Prisma Schema para PRO-MOVER Hub (PostgreSQL)
// Documentação: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PharmacyGroup {
  id          String     @id // "GRP-001", etc.
  name        String
  cnpj        String?    @unique
  responsible String?
  phone       String?
  email       String?
  createdAt   DateTime   @default(now())

  pharmacies  Pharmacy[]
  users       User[]

  @@map("pharmacy_groups")
}

model User {
  id                 Int            @id @default(autoincrement())
  name               String
  email              String         @unique
  username           String?        @unique
  passwordHash       String
  role               String         @default("pharmacy_user") // "admin" | "group_manager" | "pharmacy_user" | "client"
  groupId            String?
  pharmacyId         String?
  mustChangePassword Boolean        @default(true)
  createdAt          DateTime       @default(now())

  group              PharmacyGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  pharmacy           Pharmacy?      @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Event {
  id           String        @id // "evt-01", etc.
  name         String
  date         String
  startDate    String?
  endDate      String?
  location     String
  pharmacyId   String?
  createdAt    DateTime      @default(now())

  pharmacy     Pharmacy?     @relation(fields: [pharmacyId], references: [id])
  participants Participant[]
  triages      Triage[]

  @@map("events")
}

model Pharmacy {
  id           String    @id // "FARM-001", etc.
  name         String
  cnpj         String    @unique
  phone        String
  email        String?
  responsible  String
  crf          String?
  address      String
  neighborhood String
  city         String
  status       String         @default("Ativa") // "Ativa" | "Pendente" | "Inativa"
  notes        String?
  groupId      String?
  createdAt    DateTime       @default(now())

  group        PharmacyGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  events       Event[]
  users        User[]

  @@map("pharmacies")
}

model Participant {
  id              String           @id // "PART-001", etc.
  name            String
  birthDate       String
  age             Int
  ageGroup        String           // "18–30" | "31–45" | "46–60" | "60+"
  cpf             String
  phone           String
  eventId         String?
  createdAt       DateTime         @default(now())
  
  event           Event?           @relation(fields: [eventId], references: [id])
  attendances     Attendance[]
  medicalRecords  MedicalRecord[]
  courtesyRecords CourtesyRecord[]
  triages         Triage[]

  @@map("participants")
}

model Attendance {
  id              String      @id
  participantId   String
  date            String
  eventName       String
  type            String
  responsible     String
  status          String      // "Normal" | "Atenção" | "Alterado" | "Concluído"
  summary         String
  medicalRecordId String?
  createdAt       DateTime    @default(now())

  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("attendances")
}

model Triage {
  id              String       @id // "TR-01", etc.
  participantId   String?
  participantName String
  eventId         String
  time            String
  responsible     String
  status          String       // "Normal" | "Atenção" | "Alterado"
  systolic        Int
  diastolic       Int
  spo2            Int
  heartRate       Int
  result          String
  createdAt       DateTime     @default(now())

  event           Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant     Participant? @relation(fields: [participantId], references: [id])

  @@map("triages")
}

model MedicalRecord {
  id            String       @id // "PR-2026-001", etc.
  participantId String?
  name          String
  age           Int
  date          String
  status        String       // "Normal" | "Atenção" | "Alterado" | "Acompanhamento"
  pressure      String
  spo2          String?
  heartRate     String?
  note          String
  tone          String       // "danger" | "warning" | "info" | "success"
  createdAt     DateTime     @default(now())

  participant   Participant? @relation(fields: [participantId], references: [id])

  @@map("medical_records")
}

model CourtesyRecord {
  id            String               @id // "C-001", etc.
  participantId String
  triageId      String?
  date          String
  sessions      Int                  @default(4) // Regra: até 4 sessões por triagem
  reason        String
  createdAt     DateTime             @default(now())

  participant   Participant          @relation(fields: [participantId], references: [id], onDelete: Cascade)
  utilizations  CourtesyUtilization[]

  @@map("courtesy_records")
}

model CourtesyUtilization {
  id               String         @id // "U-001", etc.
  courtesyRecordId String
  date             String
  type             String
  professional     String
  status           String         @default("Realizado") // "Realizado" | "Agendado" | "Cancelado"
  createdAt        DateTime       @default(now())

  courtesyRecord   CourtesyRecord @relation(fields: [courtesyRecordId], references: [id], onDelete: Cascade)

  @@map("courtesy_utilizations")
}

model Settings {
  id               Int      @id @default(1)
  eventDate        String
  eventLocation    String
  sysMinThreshold  Int      @default(90)
  sysMaxThreshold  Int      @default(140)
  diaMinThreshold  Int      @default(60)
  diaMaxThreshold  Int      @default(90)
  sysThreshold     Int      @default(140)
  diaThreshold     Int      @default(90)
  spo2Threshold    Int      @default(92)
  hrMinThreshold   Int      @default(50)
  hrMaxThreshold   Int      @default(100)
  updatedAt        DateTime @updatedAt

  @@map("settings")
}
